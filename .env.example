# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL (your PC's public IP or domain)
# Example: http://your-ip:3000 or https://your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# For production deployment on Netlify, use your PC's public IP or ngrok URL
# NEXT_PUBLIC_API_URL=http://YOUR_PUBLIC_IP:3000
# or
# NEXT_PUBLIC_API_URL=https://your-ngrok-url.ngrok.io
